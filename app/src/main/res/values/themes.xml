<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EEGSender" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <!-- 五个指令按键共用的文字样式 -->
    <style name="CmdButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">112dp</item>
        <item name="android:layout_height">96dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:letterSpacing">0.02</item>
        <!-- 按下不抢焦点：否则 ScrollView 检测到子控件获焦会自动滚动，屏幕会“跳”到按键处 -->
        <item name="android:focusable">false</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
